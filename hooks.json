{
  "ai-native-auto-sync": {
    "PreToolUse": [
      {
        "matcher": "run_command|Bash|run_shell_command|bash|shell|execute_command|terminal|read_file|view_file|Read|edit_file|write_file|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/pre_tool_hook.py",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|run_command|Write|Edit|MultiEdit|Bash|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/post_tool_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/stop_gate_hook.py",
        "timeout": 120
      }
    ]
  }
}
